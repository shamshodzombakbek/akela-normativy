# Скопируйте в .env в корне проекта и заполните значения.
# Нужен входящий вебхук Битрикс24 с правом disk.

BITRIX_WEBHOOK_URL=https://YOUR.bitrix24.ru/rest/USER/TOKEN/

# Папка Normativ на Общем диске (по умолчанию Akela Normativy)
# BITRIX_NORMATIV_FOLDER=Akela Normativy
# BITRIX_NORMATIV_FOLDER_ID=

# Google Drive — те же secrets, что на streamlit.app (для shared_kpi.json)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
